{
  "manifest_version": 3,
  "name": "Simple Aloud Reader",
  "version": "1.0.0",
  "description": "Simple aloud reader for online articles with natural English voices for UK, US, and India.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Simple Aloud Reader"
  },
  "background": {
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://speech.platform.bing.com/*",
    "wss://speech.platform.bing.com/*",
    "https://translate.google.com/*",
    "https://*.tts.speech.microsoft.com/*",
    "https://api.openai.com/*",
    "https://api.elevenlabs.io/*",
    "https://api.deepinfra.com/*",
    "https://*.huggingface.co/*",
    "https://*.hf.space/*",
    "https://*.endpoints.huggingface.cloud/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Toggle Simple Aloud Reader"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "simple-aloud-reader@omkar.projects",
      "strict_min_version": "112.0",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "android": {
        "strict_min_version": "112.0"
      }
    }
  }
}
